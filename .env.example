VITE_API_URL=
VITE_DIRECTUS_URL=
# OpenRouter (default) key — local dev only. Do NOT commit real keys to public repos.
VITE_OPENROUTER_API_KEY=

# Optional: switch chat provider to 'openai' to use OpenAI API instead of OpenRouter
# Set VITE_CHAT_PROVIDER=openai to enable OpenAI provider (default: openrouter)
VITE_CHAT_PROVIDER=openrouter

# When using OpenAI provider, set your API key below (DO NOT commit secret keys).
VITE_OPENAI_API_KEY=
# Optional: choose OpenAI model (gpt-3.5-turbo, gpt-4, etc.)
VITE_OPENAI_MODEL=gpt-3.5-turbo
