    {
      "parameters": {
        "jsCode": "// Pobierz base64 z węzła 'Konwertuj Base64 na plik' (nie z $json - bo to nadpisał Create folder)\nconst sourceItem = $('Konwertuj Base64 na plik').item;\nconst base64data = sourceItem.json.base64data;\nconst filename = sourceItem.json.filename;\nconst mimeType = sourceItem.json.mimeType;\n\n// Pobierz folderId z wyniku Google Drive - Create folder (to jest $json tutaj)\nconst folderId = $input.first().json.id;\n\n// Odtwórz binary\nconst binaryData = Buffer.from(base64data, 'base64');\n\nreturn {\n  json: {\n    folderId: folderId\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      binaryData,\n      filename,\n      mimeType\n    )\n  }\n};"
      },
      "id": "10b71802-65c5-4460-8ca5-dc9add06e60f",
      "name": "Przywróć dane binarne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2752,
        1432
      ]
    },
    {
      "parameters": {
        "jsCode": "const attachment = $input.first().json.body.attachment;\n\nif (!attachment || !attachment.data) {\n  return {\n    json: {\n      file: false,\n      base64data: null,\n      filename: null,\n      mimeType: null,\n      data: $input.first().json\n    }\n  };\n}\n\nreturn {\n  json: {\n    file: true,\n    base64data: attachment.data,\n    filename: attachment.filename,\n    mimeType: attachment.mimeType,\n    data: $input.first().json\n  }\n};"
      },
